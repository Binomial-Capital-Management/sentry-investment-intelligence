VITE_API_BASE=/api
VITE_BACKEND_VERSION=v6
VITE_STREAM_MAX_RETRY_MS=20000
VITE_POLL_HEALTH_MS=30000
VITE_API_TIMEOUT_MS=120000
VITE_DEV_PROXY_TIMEOUT_MS=120000

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Logo.dev - Company logos by ticker symbol
# Get your free public token from https://logo.dev/dashboard
VITE_LOGODEV_TOKEN=your_public_token_here

# Sentry Error Tracking
VITE_SENTRY_DSN=https://your-key@sentry.io/project-id
VITE_SENTRY_DEBUG=false  # Set to true to enable in development
VITE_RELEASE_VERSION=v6.1.0

# Local development auth; must match DEV_SECRET in the backend .env
# VITE_DEV_SECRET=
