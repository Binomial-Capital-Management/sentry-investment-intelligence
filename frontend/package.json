{
  "name": "sentry-frontend",
  "version": "1.0.3",
  "description": "Sentry - Institutional Risk Analytics Platform",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,scss,json}\"",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist node_modules/.cache .vite"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.8.0",
    "@blueprintjs/icons": "^6.5.2",
    "@clerk/clerk-react": "^5.41.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "^10.5.0",
    "@tanstack/react-query": "^5.90.10",
    "@tanstack/react-virtual": "^3.13.18",
    "@types/file-saver": "^2.0.7",
    "@types/lodash": "^4.17.20",
    "@types/react-syntax-highlighter": "^15.5.13",
    "axios": "^1.6.7",
    "clsx": "^2.1.0",
    "cryptocurrency-icons": "^0.18.1",
    "date-fns": "^3.6.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^11.18.2",
    "katex": "^0.16.11",
    "lodash": "^4.17.21",
    "lucide-react": "^0.539.0",
    "markdown-to-jsx": "^7.3.2",
    "mermaid": "^11.11.0",
    "plotly.js": "^2.29.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.2.0",
    "react-big-calendar": "^1.19.4",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^9.0.1",
    "react-mosaic-component": "^6.1.1",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^6.22.0",
    "react-syntax-highlighter": "^15.6.1",
    "react-window": "^1.8.11",
    "reactflow": "^11.11.4",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "streamdown": "^1.3.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/react-plotly.js": "^2.6.3",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^1.2.2"
  }
}
