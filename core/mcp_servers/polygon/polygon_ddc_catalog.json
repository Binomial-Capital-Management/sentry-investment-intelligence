{
  "version": "0.1.0",
  "last_updated": "2025-01-05",
  "source": "Polygon.io REST API",
  "normalization": {
    "options": {
      "type": "options_contract",
      "prefix": "O:",
      "detection": {
        "prefixes": ["O:"],
        "patterns": ["^[A-Z]+\\d{6}[CP]\\d{8}$"]
      },
      "pattern": "^(?:O:)?(?P<underlying>[A-Z]+)(?P<expiry>\\d{6})(?P<option_type>[CP])(?P<strike>\\d{8})$",
      "transforms": {
        "option_type": {"map": {"C": "call", "P": "put"}},
        "strike": {"divide_by": 1000, "format": "float_trim"}
      }
    },
    "forex": {
      "type": "pair",
      "prefix": "C:",
      "separator": "",
      "detection": {
        "prefixes": ["C:"],
        "patterns": ["^[A-Z]{3}[-/][A-Z]{3}$", "^[A-Z]{6}$"]
      },
      "pattern": "^(?:C:)?(?P<base>[A-Z]{3})[-/ ]?(?P<quote>[A-Z]{3})$"
    },
    "crypto": {
      "type": "pair_compact",
      "prefix": "X:",
      "detection": {
        "prefixes": ["X:"],
        "patterns": ["^[A-Z0-9]+[-/][A-Z]{2,5}$", "^[A-Z0-9]{5,}$"]
      },
      "pattern": "^(?:X:)?(?P<base>[A-Z0-9]+)[-/]?(?P<quote>[A-Z]{2,5})$"
    }
  },
  "placeholder_rules": {
    "placeholders": {
      "options_ticker": {
        "source": "normalized"
      },
      "option_contract": {
        "source": "normalized"
      },
      "optionscontract": {
        "source": "normalized"
      },
      "ticker": {
        "source": "normalized"
      },
      "ticker.any_of": {
        "source": "normalized"
      },
      "fx_ticker": {
        "source": "normalized"
      },
      "crypto_ticker": {
        "source": "normalized"
      },
      "underlying_asset": {
        "source": "component",
        "name": "underlying"
      },
      "underlying": {
        "source": "component",
        "name": "underlying"
      },
      "direction": {
        "value": "gainers"
      },
      "multiplier": {
        "value": 1
      },
      "timespan": {
        "value": "day"
      },
      "from": {
        "type": "date_offset",
        "days": -7
      },
      "to": {
        "type": "date_offset",
        "days": 0
      },
      "date": {
        "type": "today"
      },
      "option_contracts": {
        "source": "normalized"
      }
    },
    "dataset_overrides": {
      "crypto-open-close": {
        "from": {
          "source": "component",
          "name": "base"
        },
        "to": {
          "source": "component",
          "name": "quote"
        },
        "date": {
          "type": "today"
        }
      },
      "crypto-last-trade": {
        "from": {
          "source": "component",
          "name": "base"
        },
        "to": {
          "source": "component",
          "name": "quote"
        }
      },
      "forex-conversion": {
        "from": {
          "source": "component",
          "name": "base"
        },
        "to": {
          "source": "component",
          "name": "quote"
        }
      },
      "options-snapshot-single": {
        "underlying_asset": {
          "source": "component",
          "name": "underlying"
        },
        "option_contract": {
          "source": "normalized"
        }
      },
      "options-snapshot-chain": {
        "underlying_asset": {
          "source": "component",
          "name": "underlying"
        }
      },
      "options-open-close": {
        "date": {
          "type": "today"
        }
      },
      "options-aggregates-range": {
        "from": {
          "type": "date_offset",
          "days": -7
        },
        "to": {
          "type": "date_offset",
          "days": 0
        }
      }
    }
  },
