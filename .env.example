# Binomial Risk Analyst V6 Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
#
# SECURITY CRITICAL: Database configuration requires non-superuser role
# See docs/database-setup.md for PostgreSQL role creation instructions

# ========================================
# PRIMARY API KEYS
# ========================================

# OpenAI API Key (Required for V6)
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_key_here

# Voyage AI API Key (For better financial embeddings - 40% better than OpenAI)
# Get your key at https://www.voyageai.com/
VOYAGE_API_KEY=pa-your_voyage_key_here

# Perplexity API Key (Optional - kept for potential future use)
PERPLEXITY_API_KEY=pplx-your_perplexity_key_here

# Google Gemini API Key (Optional - LiteLLM Google AI Studio proxy)
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# DeepSeek API Key (Optional - LiteLLM DeepSeek proxy)
# Request access at https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_key_here

# xAI Grok API Key (Optional - LiteLLM xAI proxy)
# Get your key at https://console.x.ai
XAI_API_KEY=your_xai_key_here

# Moonshot/Kimi API Key (Optional - for Kimi K2.5)
# Get your key at https://platform.moonshot.cn/
MOONSHOT_API_KEY=your_moonshot_key_here

# DashScope/Qwen API Key (Optional - for Qwen 3.5)
# Get your key at https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_key_here

# Z.AI/GLM API Key (Optional - for GLM-5)
# Get your key at https://open.bigmodel.cn/
ZAI_API_KEY=your_zai_key_here

# AWS Bedrock Configuration (Optional - for Llama and other Bedrock models)
# Get IAM credentials from AWS Console → IAM → Users → Security Credentials
# Make sure the IAM user has bedrock:InvokeModel permission
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# ========================================
# GOOGLE DRIVE INTEGRATION
# ========================================
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Local callback during development
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8002/api/integrations/google-drive/callback
# Production callback (set in production environment)
# GOOGLE_DRIVE_REDIRECT_URI=https://api.binomialsentry.ai/api/integrations/google-drive/callback
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly,https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/userinfo.profile,openid
GOOGLE_DRIVE_ENCRYPTION_KEY=

# ========================================
# ONEDRIVE INTEGRATION
# ========================================
ONEDRIVE_ENABLED=true
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
# Local callback during development
ONEDRIVE_REDIRECT_URI=http://localhost:8002/api/integrations/onedrive/callback
# Production callback (set in production environment)
# ONEDRIVE_REDIRECT_URI=https://api.binomialsentry.ai/api/integrations/onedrive/callback
ONEDRIVE_TENANT_ID=common
ONEDRIVE_SCOPES=offline_access,Files.Read,User.Read
ONEDRIVE_ENCRYPTION_KEY=
ONEDRIVE_CACHE_TTL_SEC=300

# Frontend picker keys (Google Picker + OneDrive SDK)
VITE_GOOGLE_PICKER_API_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_ONEDRIVE_CLIENT_ID=

# ========================================
# V6 CONFIGURATION (Production)
# ========================================

# Enable V6 OpenAI Agents SDK Interface
FEATURE_V6_INTERFACE=true

# Enable LangGraph Orchestration (Handback Fix)
# Set to true to use LangGraph supervisor pattern for agent handoffs
# Solves the handback problem where Risk Specialist cannot return to Generalist
ENABLE_LANGGRAPH=true

# LangGraph Router Model Configuration
# Options: gpt-5-mini, gpt-4o-mini, gpt-oss-20b (via Groq), gpt-oss-20b-hf (via HuggingFace)
# Default: gpt-5-mini (OpenAI)
# For fastest routing (<100ms), use gpt-oss-20b with Groq
LANGGRAPH_ROUTER_MODEL=gpt-5-mini

# GPT-5 Vision Configuration
# Model for enhanced file processing (images, PDFs, documents)
# Options: gpt-5, gpt-5-mini, gpt-5-nano
# Pricing: $1.25/1M, $0.25/1M, $0.05/1M respectively
GPT5_VISION_MODEL=gpt-5-mini
PDF_VISION_WORKERS=4

# File Processing Limits
PDF_PAGE_LIMIT=5              # Max pages to process for PDFs
IMAGE_MAX_SIZE=2048           # Max image size before optimization (pixels)
EXCEL_SHEET_LIMIT=5           # Max sheets to process for Excel files

# Router Provider Configuration (for non-OpenAI models)
# Required if using gpt-oss-20b or other non-OpenAI models
# Get your Groq API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Get your HuggingFace token at https://huggingface.co/settings/tokens
# Also used for FinBERT sentiment analysis (free tier available)
HF_TOKEN=your_huggingface_token_here

# Database Persistence Configuration
# LangGraph and OpenAI Agents SDK use separate databases to avoid conflicts
# LangGraph uses async SQLite for checkpoint persistence (routing/conversation flow)
# OpenAI uses sync SQLite for session management (agent state)
LANGGRAPH_DB_PATH=langgraph_state.db        # LangGraph async checkpoint database
OPENAI_SESSIONS_DB_PATH=binomial_sessions.db # OpenAI Agents SDK sync session database

# Streaming + compaction configuration
STREAM_HEARTBEAT_SEC=10
STREAM_TYPING_DELAY_SEC=0.015
ENABLE_TRUE_TOKEN_STREAMING=false
ENABLE_STREAM_EVENTS=true

# Cross-provider compaction (provider switch continuity)
CROSS_PROVIDER_COMPACTION_ENABLED=true
CROSS_PROVIDER_COMPACTION_SCAN_TOKENS=200000
CROSS_PROVIDER_COMPACTION_INJECT_TOKENS=30000
CROSS_PROVIDER_COMPACTION_SSE_ENABLED=true
# Optional: use an OpenAI model to summarize cross-provider context before injection
CROSS_PROVIDER_COMPACTION_SUMMARY_MODEL=
CROSS_PROVIDER_COMPACTION_SUMMARY_TIMEOUT_SEC=8.0
CROSS_PROVIDER_COMPACTION_SUMMARY_MAX_OUTPUT_TOKENS=2048

# SQLite session compaction (Agents SDK persisted history)
# When enabled, older items are summarized via the same model/settings as cross-provider compaction
# (CROSS_PROVIDER_COMPACTION_SUMMARY_MODEL / *_TIMEOUT_SEC / *_MAX_OUTPUT_TOKENS) and reinjected.
SQLITE_SESSION_COMPACTION_SUMMARY_ENABLED=false

# V6 uses OPENAI_API_KEY from above (must be set if V6 enabled)
# V6 MCP servers are auto-configured - no additional config needed

# ========================================
# SHARED CONFIGURATION (Both V5 and V6)
# ========================================

# Optional API Keys
# FRED API Key - Get yours at https://fred.stlouisfed.org/docs/api/fred/
FRED_API_KEY=your_fred_api_key_here

# Redis Configuration (optional but recommended for caching)
REDIS_URL=redis://localhost:6379

# Portfolio Configuration
PORTFOLIO_VALUE=1000000        # Portfolio value in USD
MC_SIMULATIONS=1000           # Monte Carlo simulations (100-100000)
MC_TIME_HORIZON=252           # Time horizon in trading days

# Risk Analysis Settings
# Risk-free rate: If not set, automatically fetches from FRED (TB3MS series)
# RISK_FREE_RATE=0.0425       # Optional: Override automatic FRED fetching
VAR_CONFIDENCE_LEVEL=0.95     # VaR confidence level (0-1)
MAX_CONCENTRATION=0.40        # Maximum position concentration (0-1)
MIN_SHARPE_RATIO=0.5         # Minimum acceptable Sharpe ratio

# Data Settings
LOOKBACK_YEARS=3              # Years of historical data (1-30)
DATA_FREQUENCY=daily          # Options: daily, weekly, monthly
API_TIMEOUT=30.0             # API timeout in seconds

# Server Configuration
FLASK_ENV=development         # Options: development, production
PORT=8002                    # FastAPI server port
FASTAPI_RELOAD=false         # Auto-reload on code changes
FASTAPI_WORKERS=2            # Run two workers locally to mirror prod fan-out/resume paths

# Logging
LOG_LEVEL=INFO               # Options: DEBUG, INFO, WARNING, ERROR

# ========================================
# TASK SCHEDULER CONFIGURATION
# ========================================
# Automated task execution scheduler using APScheduler
# Controls the polling interval and batch size for executing scheduled tasks

# Enable/disable task scheduler
TASK_SCHEDULER_ENABLED=true

# Polling interval in seconds (how often to check for due tasks)
# Default: 600 seconds (10 minutes)
TASK_SCHEDULER_POLL_INTERVAL=600

# Maximum number of tasks to execute in a single polling cycle
# Default: 50 tasks
TASK_SCHEDULER_BATCH_SIZE=50

# Misfire grace time in seconds (how late a task can start and still execute)
# Default: 300 seconds (5 minutes)
TASK_SCHEDULER_MISFIRE_GRACE=300

# ========================================
# POSTGRESQL CONFIGURATION (CRITICAL FOR SECURITY)
# ========================================
# IMPORTANT: Use a non-superuser role with proper RLS settings
# See docs/database-setup.md for role creation instructions

# PostgreSQL connection string
# For local development:
DATABASE_URL=postgresql://binomial_app:YOUR_SECURE_PASSWORD_HERE@localhost/binomial_dev
# For production (use environment-specific secrets):
# DATABASE_URL=postgresql://binomial_app:${DB_APP_PASSWORD}@your-db-host/binomial_prod

# Alternative: Use separate environment variable for password
# DB_APP_PASSWORD=your_secure_password_here
# Then construct DATABASE_URL in your deployment scripts

# Database role name (default: binomial_app)
# This should match the role created via infrastructure
DB_APP_ROLE=binomial_app

# Enable PostgreSQL (set to true when DATABASE_URL is configured)
ENABLE_POSTGRES=true

# Optional: Enable RLS canary test on startup (for staging/dev only)
# This will create and delete a test row to verify RLS is working
RUN_RLS_CANARY_TEST=false  # Set to true for staging environments

# ⚠️ DANGER: Skip RLS security checks (DEV ONLY - NEVER USE IN PRODUCTION!)
# This will bypass critical security checks on startup
# Setting this to true in production will cause the application to FAIL
SKIP_RLS_CHECKS=false  # NEVER set to true in staging/production!

# ========================================
# AUTHENTICATION (Clerk)
# ========================================
# Get your keys from https://dashboard.clerk.com
# Leave empty to run without authentication

# Clerk Secret Key for backend verification
CLERK_SECRET_KEY=sk_test_your_clerk_secret_here

# Clerk Webhook Secret for user sync
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Feature flag to enable/disable auth
ENABLE_AUTH=false
VITE_ENABLE_AUTH=false

# Dev user ID for local development (when auth is disabled)
DEV_INTERNAL_USER_ID=dev-local-user

# ========================================
# MIGRATION GUIDE
# ========================================
#
# To migrate from V5 to V6:
# 1. Ensure OPENAI_API_KEY is set (required for V6)
# 2. Set FEATURE_V6_INTERFACE=true
# 3. Access V6 at /v6/chat endpoint
# 4. V5 remains available at /api/chat
#
# Both versions can run simultaneously!

# ========================================
# SEARCH CONFIGURATION (Web Search Enhancement)
# ========================================

# Search Streaming Configuration
SEARCH_STREAM_ENABLED=true            # Enable SSE streaming for search results
SEARCH_CACHE_ENABLED=true             # Enable Redis caching for search results
SEARCH_CACHE_TTL=3600                 # Cache TTL in seconds (1 hour default)
SEARCH_MAX_CONCURRENT=3               # Maximum concurrent search operations
PERPLEXITY_STREAM_MODEL=sonar-pro    # Model for streaming search (sonar-pro recommended)

# Search Provider Settings
SEARCH_PRIMARY_PROVIDER=perplexity    # Primary search provider
SEARCH_FALLBACK_PROVIDERS=openai,brave # Comma-separated fallback providers
SEARCH_TIMEOUT=30                     # Search timeout in seconds
SEARCH_MAX_RETRIES=3                  # Maximum retry attempts per provider
SEARCH_MAX_RESULTS=10                 # Default maximum results per search

# ========================================
# ERROR TRACKING (Sentry.io)
# ========================================

# Sentry Configuration for Production Monitoring
# IMPORTANT: Never hardcode the actual DSN in source code!
# Move this to your .env file, not in source code
SENTRY_DSN=  # Leave empty to disable, or set via environment variable
SENTRY_TRACES_SAMPLE_RATE=0.1                     # 10% trace sampling (adjust for production)
SENTRY_PROFILES_SAMPLE_RATE=0.1                   # 10% profiling (performance impact)
ENVIRONMENT=development                            # Options: development, staging, production
RELEASE_VERSION=v6.1.0                            # Your app version for tracking

# ========================================
# SECURITY NOTES
# ========================================
#
# 1. NEVER commit your actual .env file
# 2. Use strong, unique API keys
# 3. Rotate keys every 90 days
# 4. Use environment-specific files in production
#    (.env.development, .env.production)
# 5. Consider using a secrets manager for production

# Local development auth (bypasses Clerk when ENVIRONMENT is not "production").
# Use the same random value as VITE_DEV_SECRET in frontend/.env, e.g. `openssl rand -hex 32`.
# DEV_SECRET=
